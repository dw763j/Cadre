{
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/results/**": true,
      "**/results_multiple/**": true,
      "**/logs/**": true,
      "**/__pycache__/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.venv/**": true,
      "**/.mypy_cache/**": true,
      "**/.pytest_cache/**": true,
      "**/data/**": true,
      "**/*.zip": true,
      "**/*.log": true,
      "**/*.json": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true,
      "**/.venv": true,
      "**/data": true,
      "**/results": true,
      "**/results_multiple": true,
      "**/logs": true,
      "**/__pycache__": true,
      "**/*.zip": true,
      "**/*.log": true,
      "**/*.json": true
    },
    // "files.exclude": {
    //   "**/results": true,
    //   "**/results_multiple": true,
    //   "**/logs": true,
    //   "**/__pycache__": true,
    //   "**/*.zip": true,
    //   "**/*.log": true
    // },
    "git.autofetch": false,
    "typescript.disableAutomaticTypeAcquisition": true,
    "cursorpyright.analysis.exclude": ["**/.git/**", "**/results/**","**/results_multiple/**"],
    "python.analysis.indexing": false,
    "python.analysis.autoImportCompletions": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 0,
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "cursorpyright.analysis.autoImportCompletions": false
}